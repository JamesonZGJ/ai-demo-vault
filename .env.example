# 浏览器和服务端都只使用 Supabase 可公开密钥；严禁在 NEXT_PUBLIC_* 中放 Service Role Key。
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-or-production-publishable-key

# 唯一公开站点源地址，不带末尾斜杠；用于 canonical、邮件回调和 sitemap。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 本地使用 local；Vercel Preview 使用 preview（只读静态目录，不连接 Supabase）；生产必须为 production 或不设置。
APP_DEPLOYMENT_TIER=local

# Vercel Preview 会自动提供 VERCEL_URL；Preview 模式可不设置 NEXT_PUBLIC_SITE_URL，应用会用该地址生成 canonical、OG、sitemap 和 robots。

# 生产发布预检和公网只读验收单独使用；本地开发和 pnpm verify 不需要。
# PRODUCTION_BASE_URL=https://vault.example.com
# EXPECTED_SUPABASE_PROJECT_REF=abcdefghijklmnopqrst
# PRODUCTION_SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
# PRODUCTION_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# EXPECTED_RELEASE_COMMIT_SHA=完整的_Git_commit_SHA
